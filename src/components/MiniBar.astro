---
// The fixed escape hatch: bottom on mobile, top on desktop. Exactly four items.
// The fourth, "Brain", opens the brain panel on the home page (dom.ts). Without
// JS, or on other pages, it is a plain link to the privacy page, which explains it.
const items = [
  { href: '/resume/', label: 'Résumé' },
  { href: '/#education', label: 'Education' },
  { href: '/#contact', label: 'Contact' },
];
---

<nav class="minibar glass glass--lens" aria-label="Quick links">
  <ul>
    {items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
    <li>
      <a href="/privacy/" data-brain-open aria-haspopup="dialog">
        <svg class="icon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle cx="8" cy="8" r="2" fill="currentColor" />
          <circle cx="3" cy="4" r="1.3" fill="currentColor" />
          <circle cx="13" cy="4" r="1.3" fill="currentColor" />
          <circle cx="8" cy="14" r="1.3" fill="currentColor" />
          <path d="M3 4l5 4 5-4M8 8v6" fill="none" stroke="currentColor" stroke-width="1" />
        </svg>
        Brain
      </a>
    </li>
  </ul>
</nav>

<style>
  /* A floating glass dock: bottom centre on phones, top right on desktop. */
  .minibar {
    position: fixed;
    left: 50%;
    bottom: calc(10px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(calc(100% - 20px), 30rem);
    z-index: 50;
    border-radius: 999px;
    padding: 4px;
  }
  ul {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  li { flex: 1 1 0; max-width: 11rem; }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    gap: 0.35rem;
    text-decoration: none;
    text-align: center;
  }
  .icon { flex: none; color: var(--accent-ink); }
  a:hover { background: var(--glass-sheen); color: var(--accent-ink); }
  @media (min-width: 48rem) {
    .minibar {
      top: 14px;
      bottom: auto;
      left: auto;
      right: 20px;
      transform: none;
      width: auto;
    }
    ul { justify-content: flex-end; }
    li { flex: 0 0 auto; }
    a { padding: 0 1rem; min-height: 42px; }
  }
  @media print { .minibar { display: none; } }
</style>
