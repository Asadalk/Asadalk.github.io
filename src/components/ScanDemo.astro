---
// "Scan a photo with my model": full OCR on the portfolio API (space/app.py):
// the fine-tuned YOLO11n finds the text, EfficientNetV2-L names the script and
// PARSeq reads each word. If the server can't be reached, the same YOLO11n runs
// in the browser instead (boxes only). Without JS it shows a precomputed result.
import sample from '../content/data/scan-sample.json';

type Word = { box: number[]; text: string; script: string };
const words: Word[] = (sample as { words?: Word[] }).words ?? sample.detections.map((d) => ({ box: d.box, text: '', script: '' }));
const lines: string[][] = (sample as { lines?: string[][] }).lines ?? [];
---

<div class="scan" id="scan" data-scan>
  <p class="where mono" data-where>Detection, script identification and recognition, with my fork of IndicPhotoOCR</p>
  <figure class="stage" data-stage>
    <img
      src={sample.image}
      width={sample.width}
      height={sample.height}
      alt="A busy market street in Paharganj, Delhi, full of shop signs."
      loading="lazy"
      decoding="async"
      data-img
    />
    <svg viewBox={`0 0 ${sample.width} ${sample.height}`} preserveAspectRatio="none" aria-hidden="true" data-overlay>
      {words.map((w, i) => (
        <g data-word={i}>
          <rect class="edge" x={w.box[0]} y={w.box[1]} width={w.box[2] - w.box[0]} height={w.box[3] - w.box[1]} />
          <rect class="hit" x={w.box[0]} y={w.box[1]} width={w.box[2] - w.box[0]} height={w.box[3] - w.box[1]} />
        </g>
      ))}
    </svg>
  </figure>

  <div class="controls" data-controls hidden>
    <label class="button button--primary pick">
      Choose a photo
      <input type="file" accept="image/*" class="visually-hidden" data-file />
    </label>
    <label class="button button--ghost pick" data-camera hidden>
      Take a photo
      <input type="file" accept="image/*" capture="environment" class="visually-hidden" data-file />
    </label>
    <button type="button" class="button button--ghost" data-sample>Run on the sample</button>
  </div>
  <p class="status" role="status" aria-live="polite" data-status>
    {lines.length
      ? `${words.length} words read from the sample photo. Turn on JavaScript to try your own photos.`
      : `${words.length} text regions found in the sample photo. Turn on JavaScript to try your own photos.`}
  </p>

  <div class="text-out" data-text-out hidden={lines.length === 0}>
    <p class="label mono">Text found, line by line</p>
    <ol class="lines" data-lines>
      {lines.map((l) => <li>{l.join(' ')}</li>)}
    </ol>
  </div>

  <p class="credit muted">
    Sample photo: <a href="https://commons.wikimedia.org/wiki/File:Main_Bazaar,_Paharganj,_Delhi,_India.jpg">Main Bazaar, Paharganj, Delhi</a>{' '}
    by Vyacheslav Argenberg, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, resized. Photos you upload are processed and
    deleted straight away.
  </p>
</div>

<script>
  import type { WorkerOut } from '../workers/detect.worker';
  import sample from '../content/data/scan-sample.json';
  import { api, hasApi, WAKING } from '../lib/api';

  type Word = { box: number[]; text: string; script: string; confidence?: number };
  type OcrOut = { width: number; height: number; words: Word[]; lines: string[][]; timings_ms: Record<string, number> };

  const root = document.querySelector<HTMLElement>('[data-scan]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const img = root.querySelector<HTMLImageElement>('[data-img]')!;
    const overlay = root.querySelector<SVGSVGElement>('[data-overlay]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const where = root.querySelector<HTMLElement>('[data-where]')!;
    const controls = root.querySelector<HTMLElement>('[data-controls]')!;
    const camera = root.querySelector<HTMLElement>('[data-camera]')!;
    const textOut = root.querySelector<HTMLElement>('[data-text-out]')!;
    const linesEl = root.querySelector<HTMLOListElement>('[data-lines]')!;
    const buttons = [...root.querySelectorAll<HTMLElement>('.controls .button')];
    const NS = 'http://www.w3.org/2000/svg';

    controls.hidden = false;
    if (matchMedia('(pointer: coarse)').matches) camera.hidden = false;
    status.textContent = 'Choose or take a photo with text in it, or run the model on the sample.';

    let objectUrl: string | null = null;
    let opened = false;
    let nextId = 1;
    let worker: Worker | null = null;
    const fmt = (ms: number) => (ms < 1000 ? `${Math.round(ms)} ms` : `${(ms / 1000).toFixed(1)} s`);
    const busy = (on: boolean) => {
      stage.classList.toggle('busy', on);
      for (const b of buttons) b.classList.toggle('is-disabled', on);
    };

    const draw = (w: number, h: number, words: { box: number[] }[]) => {
      overlay.setAttribute('viewBox', `0 0 ${w} ${h}`);
      overlay.replaceChildren(
        ...words.map((d, i) => {
          const g = document.createElementNS(NS, 'g');
          g.dataset.word = String(i);
          for (const cls of ['edge', 'hit']) {
            const r = document.createElementNS(NS, 'rect');
            r.setAttribute('class', cls);
            r.setAttribute('x', String(d.box[0]));
            r.setAttribute('y', String(d.box[1]));
            r.setAttribute('width', String(d.box[2] - d.box[0]));
            r.setAttribute('height', String(d.box[3] - d.box[1]));
            g.append(r);
          }
          return g;
        }),
      );
    };

    // Lines from the fork's detect_para; each word is a button that highlights its box.
    const showText = (words: Word[], lines: string[][]) => {
      const used = new Set<number>();
      const indexOf = (t: string) => {
        const i = words.findIndex((w, k) => !used.has(k) && w.text === t);
        if (i >= 0) used.add(i);
        return i;
      };
      linesEl.replaceChildren(
        ...lines.map((line) => {
          const li = document.createElement('li');
          line.forEach((t, j) => {
            const i = indexOf(t);
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'word';
            b.textContent = t || '·';
            if (i >= 0 && words[i].script) b.title = words[i].script;
            b.addEventListener('click', () => {
              overlay.querySelectorAll('.on').forEach((g) => g.classList.remove('on'));
              if (i >= 0) overlay.querySelector(`[data-word="${i}"]`)?.classList.add('on');
            });
            li.append(b);
            if (j < line.length - 1) li.append(' ');
          });
          return li;
        }),
      );
      textOut.hidden = lines.length === 0;
    };

    const usedEvent = () => window.dispatchEvent(new CustomEvent('demo', { detail: { id: 'research-bstd', action: 'used' } }));

    // ---- server: full OCR -------------------------------------------------
    const shrink = async (file: Blob, max = 2400): Promise<Blob> => {
      const bm = await createImageBitmap(file, { imageOrientation: 'from-image' });
      const s = Math.min(1, max / Math.max(bm.width, bm.height));
      if (s === 1 && file.type === 'image/jpeg') {
        bm.close();
        return file;
      }
      const c = new OffscreenCanvas(Math.round(bm.width * s), Math.round(bm.height * s));
      c.getContext('2d')!.drawImage(bm, 0, 0, c.width, c.height);
      bm.close();
      return c.convertToBlob({ type: 'image/jpeg', quality: 0.9 });
    };

    async function viaServer(file: Blob): Promise<boolean> {
      if (!hasApi()) return false;
      try {
        status.textContent = 'Reading the text…';
        const body = new FormData();
        body.append('image', await shrink(file), 'photo.jpg');
        const r = await api<OcrOut>('/ocr', { method: 'POST', body }, { onSlow: () => (status.textContent = WAKING), timeoutMs: 180_000 });
        draw(r.width, r.height, r.words);
        showText(r.words, r.lines);
        stage.dataset.result = JSON.stringify({ width: r.width, height: r.height, words: r.words.length, source: 'server' });
        const t = r.timings_ms;
        where.textContent = 'Detection, script identification and recognition, with my fork of IndicPhotoOCR';
        status.textContent = r.words.length
          ? `Read ${r.words.length} word${r.words.length === 1 ? '' : 's'} in ${fmt(t.detect + t.script_id + t.recognise)} ` +
            `(detection ${fmt(t.detect)}, script ID ${fmt(t.script_id)}, recognition ${fmt(t.recognise)}).`
          : 'No text found in this photo. Try one with signs or labels.';
        usedEvent();
        return true;
      } catch (err) {
        status.textContent = `The OCR server is unavailable (${(err as Error).message}), so the detector will run on your device instead: boxes only, no text.`;
        return false;
      }
    }

    // ---- fallback: YOLO11n in this browser ---------------------------------
    const getWorker = () => {
      if (worker) return worker;
      worker = new Worker(new URL('../workers/detect.worker.ts', import.meta.url), { type: 'module' });
      worker.onmessage = (e: MessageEvent<WorkerOut>) => {
        const m = e.data;
        if (m.type === 'progress') {
          const pct = Math.min(100, Math.round((m.loaded / m.total) * 100));
          status.textContent = `Downloading the detector (${(m.total / 1e6).toFixed(1)} MB, only the first time): ${pct}%`;
        } else if (m.type === 'result') {
          busy(false);
          draw(m.width, m.height, m.detections);
          stage.dataset.result = JSON.stringify({ width: m.width, height: m.height, detections: m.detections, backend: m.backend, timings: m.timings, source: 'browser' });
          const t = m.timings;
          where.textContent = 'Detection only, running in your browser';
          status.textContent =
            `Found ${m.detections.length} text region${m.detections.length === 1 ? '' : 's'} in ` +
            `${fmt(t.decode + t.preprocess + t.inference + t.postprocess)} on your device (${m.backend === 'webgpu' ? 'WebGPU' : 'WebAssembly'}).`;
          usedEvent();
        } else if (m.type === 'error') {
          busy(false);
          status.textContent = `The model couldn't run here (${m.message}).`;
        }
      };
      worker.onerror = (e) => {
        busy(false);
        status.textContent = `The model couldn't run here (${e.message || 'worker error'}).`;
      };
      return worker;
    };
    const params = new URLSearchParams(location.search);
    const viaBrowser = (file: Blob) => {
      const prefer = params.get('ort') === 'wasm' ? 'wasm' : undefined;
      getWorker().postMessage({ type: 'detect', id: nextId++, file, prefer });
    };
    // ?local=1 or ?ort=wasm skips the server (used by the browser parity test).
    const localOnly = params.has('local') || params.get('ort') === 'wasm';

    const run = async (file: Blob, showUrl?: string) => {
      if (stage.classList.contains('busy')) return;
      if (!opened) {
        opened = true;
        window.dispatchEvent(new CustomEvent('demo', { detail: { id: 'research-bstd', action: 'open' } }));
      }
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = showUrl ? null : URL.createObjectURL(file);
      img.src = showUrl ?? objectUrl!;
      overlay.replaceChildren();
      linesEl.replaceChildren();
      textOut.hidden = true;
      delete stage.dataset.result;
      busy(true);
      if (!localOnly && (await viaServer(file))) return busy(false);
      viaBrowser(file);
    };

    for (const input of root.querySelectorAll<HTMLInputElement>('[data-file]')) {
      input.addEventListener('change', () => {
        const f = input.files?.[0];
        if (f) void run(f);
        input.value = '';
      });
    }
    root.querySelector('[data-sample]')!.addEventListener('click', async () => {
      try {
        const blob = await (await fetch(sample.image)).blob();
        void run(blob, sample.image);
      } catch (err) {
        status.textContent = `Could not load the sample (${String(err)}).`;
      }
    });

    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting && stage.dataset.result) {
        window.dispatchEvent(new CustomEvent('demo', { detail: { id: 'research-bstd', action: 'close' } }));
      }
    }).observe(root);
  }
</script>

<style>
  .scan { margin: 0 0 1.5rem; }
  .where { font-size: 0.72rem; color: var(--ok); margin-bottom: 0.5rem; }
  .stage {
    position: relative;
    margin: 0 0 0.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg);
    line-height: 0;
  }
  .stage img { display: block; width: 100%; height: auto; }
  .stage svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .stage :global(rect) { fill: none; vector-effect: non-scaling-stroke; }
  .stage :global(.edge) { stroke: #221e1c; stroke-width: 4; }
  .stage :global(.hit) { stroke: var(--detect); stroke-width: 2; }
  .stage :global(.on .hit) { stroke-width: 5; }
  .stage :global(.on .edge) { stroke-width: 8; }
  .stage:global(.busy) img { opacity: 0.55; transition: opacity var(--dur) var(--ease); }
  .controls { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.5rem; }
  .controls :global(.is-disabled) { opacity: 0.6; pointer-events: none; }
  .pick:focus-within { outline: 3px solid var(--detect); outline-offset: 2px; box-shadow: 0 0 0 5px var(--detect-edge); }
  .status { font-size: 0.95rem; min-height: 1.6em; }
  .text-out { margin: 0.25rem 0 0.75rem; }
  .label { font-size: 0.72rem; color: var(--muted); margin: 0 0 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .lines { margin: 0; padding-left: 1.4rem; font-size: 1.05rem; line-height: 1.9; }
  .lines :global(.word) {
    font: inherit;
    padding: 0 0.15rem;
    background: none;
    border: 0;
    border-bottom: 1px dotted var(--muted);
    color: var(--text);
    cursor: pointer;
  }
  .lines :global(.word:hover) { background: color-mix(in srgb, var(--detect) 35%, transparent); }
  .credit { font-size: 0.75rem; }
</style>
