---
// A reserved line at the end of a section where the brain may place one small
// suggestion. The space is always there, so a suggestion appearing or going
// away never moves anything. Empty (and inert) without JavaScript.
interface Props { section: string }
const { section } = Astro.props;
---

<div class="suggest-slot" data-suggest-slot={section}>
  <p class="chip" hidden>
    <a class="chip-link" href="#"></a>
    <button type="button" class="chip-x" aria-label="Dismiss suggestion">
      <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
    </button>
  </p>
</div>

<style>
  .suggest-slot {
    min-height: 3rem;
    display: flex;
    align-items: center;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    max-width: 100%;
    padding-left: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: box-shadow var(--dur) var(--ease);
  }
  .chip[hidden] { display: none; }
  .chip.soft { box-shadow: 0 0 0 2px color-mix(in srgb, var(--detect) 70%, transparent); }
  .chip-link {
    padding: 0.55rem 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }
  .chip-link:hover { text-decoration: underline; }
  .chip-x {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .chip-x:hover { color: var(--text); }
  @media print { .suggest-slot { display: none; } }
</style>
