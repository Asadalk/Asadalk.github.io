---
// "Read the Street": the hero. Two layouts of the same street; CSS shows the
// one that fits. Signboards are the main navigation and work as plain anchor
// links without JavaScript. With JS, tapping one "locks on" to that sign (its
// box thickens, the others dim) and the page scrolls smoothly to the section.
import Scene from './Scene.astro';
import { site } from '../lib/content';
import { wideScene, tallScene } from '../lib/street';
import pm from '../content/data/smoketrail/pm25-daily.json';
import { hazeCaption, hazeLevel, hazeTag, pickDay, type PmDay } from '../lib/haze';

const wide = wideScene(site.signboards);
const tall = tallScene(site.signboards);
// Real haze: Delhi's PM2.5 on this calendar day in autumn 2019 (SmokeTrail).
// Computed at build time for no-JS visitors; the script below redoes it for
// the visitor's own date.
const season2019 = (pm.days as PmDay[]).filter(([d]) => d.startsWith('2019-'));
const today = pickDay(season2019, new Date());
---

<nav class="street" aria-label="Sections" data-street style={`--haze: ${hazeLevel(today[1])}`}>
  <div class="frame" data-frame>
    <Scene scene={tall} />
    <Scene scene={wide} />
  </div>
  <a class="air-tag" href="#smoketrail" data-haze-tag title="Where this smog comes from: my SmokeTrail project">{hazeTag(today)}</a>
</nav>
<p class="legend wrap">
  The boxes show what a text detector sees: what each sign is, and how sure it is (0–1). Illustrative here; the photo
  demo runs my real model.
</p>
<p class="legend wrap haze-line" data-haze-caption>{hazeCaption(today)}</p>
<script type="application/json" data-haze-days set:html={JSON.stringify(season2019)} />

<script>
  import { hazeCaption, hazeLevel, hazeTag, pickDay, type PmDay } from '../lib/haze';

  // Re-pick the haze for the visitor's own date (the HTML has the build date's).
  {
    const el = document.querySelector<HTMLElement>('[data-street]');
    const days = JSON.parse(document.querySelector('[data-haze-days]')?.textContent || '[]') as PmDay[];
    if (el && days.length) {
      const day = pickDay(days, new Date());
      el.style.setProperty('--haze', String(hazeLevel(day[1])));
      const cap = document.querySelector('[data-haze-caption]');
      if (cap) cap.textContent = hazeCaption(day);
      const tag = document.querySelector('[data-haze-tag]');
      if (tag) tag.textContent = hazeTag(day);
    }
  }

  const street = document.querySelector<HTMLElement>('[data-street]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (street) {
    // Lock on to the tapped sign, then scroll to its section. A modified click
    // (e.g. open in new tab) falls through to the plain link.
    street.addEventListener('click', (e) => {
      const shop = (e.target as Element).closest<SVGAElement>('a.shop');
      if (!shop || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      const target = document.getElementById(shop.dataset.target ?? '');
      if (!target) return;
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('signboard', { detail: shop.dataset.target }));

      const scene = shop.closest('svg');
      scene?.classList.add('locking');
      shop.classList.add('locked');
      const go = () => {
        target.scrollIntoView({ behavior: reduce.matches ? 'instant' : 'smooth', block: 'start' });
        history.pushState(null, '', `#${target.id}`);
        const heading = target.querySelector<HTMLElement>('h2') ?? target;
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
        window.setTimeout(() => {
          scene?.classList.remove('locking');
          shop.classList.remove('locked');
        }, 700);
      };
      if (reduce.matches) go();
      else window.setTimeout(go, 260);
    });

    // Gentle parallax on the far skyline and the wires, only while the hero is
    // on screen and motion is allowed.
    const layers = [...street.querySelectorAll<SVGGElement>('[data-depth]')];
    let visible = true;
    let queued = false;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(street);
    const paint = () => {
      queued = false;
      const y = window.scrollY;
      for (const l of layers) l.style.transform = `translateY(${y * Number(l.dataset.depth)}px)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!visible || reduce.matches || queued) return;
        queued = true;
        requestAnimationFrame(paint);
      },
      { passive: true },
    );
  }
</script>

<style>
  /* The street sits behind a pane of glass: rounded, with a bright rim. */
  .street {
    position: relative;
    max-width: 75rem;
    margin: 0 var(--gutter);
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow:
      inset 0 0 0 1px var(--glass-edge),
      0 24px 50px -26px var(--glass-shadow),
      0 2px 8px -3px var(--glass-shadow);
  }
  .street::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(150deg, var(--glass-sheen) 0%, transparent 22%, transparent 80%, var(--glass-edge) 100%);
    box-shadow: inset 0 1px 0.5px var(--glass-rim);
  }
  @media (min-width: 77rem) {
    .street { margin: 0 auto; }
  }
  .street :global(.scene) {
    display: block;
    width: 100%;
    height: auto;
  }
  .street :global(.scene--wide) { display: none; }
  @media (min-width: 40rem) {
    .street :global(.scene--tall) { display: none; }
    .street :global(.scene--wide) { display: block; }
  }

  .street :global(.haze) { opacity: var(--haze); pointer-events: none; }
  .street :global(.lit) { fill: var(--window-lit) !important; }
  .street :global(.hi) { font-family: var(--font-deva); }
  .street :global(.en) { font-family: var(--font-display); }
  .street :global(.plaque) { font-family: var(--font-mono); font-size: 10px; fill: var(--sign-kohl); }

  /* Detection boxes: 2.5px chartreuse over a Kohl edge, drawn like a stroke. */
  .street :global(.box-edge),
  .street :global(.box) {
    stroke-dasharray: var(--p);
    stroke-dashoffset: var(--p);
    animation: draw 650ms var(--ease) var(--d) forwards;
  }
  .street :global(.box-edge) { stroke: var(--sign-kohl); stroke-width: 5; }
  .street :global(.box) { stroke: var(--detect); stroke-width: 2.5; }
  .street :global(.tag) {
    opacity: 0;
    animation: appear 220ms ease-out calc(var(--d) + 520ms) forwards;
  }
  .street :global(.tag-bg) { fill: var(--detect); stroke: var(--sign-kohl); stroke-width: 1; }
  .street :global(.tag-text) { font-family: var(--font-mono); font-size: 12px; fill: var(--sign-kohl); }

  .street :global(.shop) { cursor: pointer; outline: none; }
  .street :global(.shop .board) { transition: filter var(--dur) var(--ease); }
  .street :global(.shop:hover .board) { filter: brightness(1.08); }
  .street :global(.shop:hover + .det .box),
  .street :global(.shop:focus-visible + .det .box) { stroke-width: 4.5; }
  .street :global(.shop:hover + .det .box-edge),
  .street :global(.shop:focus-visible + .det .box-edge) { stroke-width: 8; }

  /* Lock-on: the chosen sign's box thickens, everything else dims. */
  .street :global(.shop) { transition: opacity 220ms var(--ease); }
  .street :global(.det) { transition: opacity 220ms var(--ease); }
  .street :global(.locking .shop:not(.locked)),
  .street :global(.locking .shop:not(.locked) + .det) { opacity: 0.3; }
  .street :global(.locked + .det .box) { stroke-width: 6; transition: stroke-width 200ms var(--ease); }
  .street :global(.locked + .det .box-edge) { stroke-width: 10; transition: stroke-width 200ms var(--ease); }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes appear { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .street :global(.box-edge),
    .street :global(.box) { animation: none; stroke-dashoffset: 0; }
    .street :global(.tag) { animation: none; opacity: 1; }
  }

  /* Air-quality tag in the sky corner: what the smog is, linking to its source. */
  .air-tag {
    position: absolute;
    top: 10px;
    left: 12px;
    z-index: 2;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--text);
    text-decoration: none;
    background: var(--glass-tint-strong);
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    backdrop-filter: blur(10px) saturate(160%);
    box-shadow: inset 0 1px 0.5px var(--glass-rim), inset 0 0 0 1px var(--glass-edge), 0 6px 14px -8px var(--glass-shadow);
  }
  .air-tag:hover { background: var(--glass-tint); text-decoration: underline; }
  @media (min-width: 48rem) {
    .air-tag { top: 14px; left: 16px; font-size: 0.72rem; }
  }
  .haze-line { margin-top: 0.15rem !important; }
  .legend {
    margin: 0.6rem auto 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }
  @media print {
    .street, .legend { display: none; }
  }
</style>
