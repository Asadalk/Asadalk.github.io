---
// "Ask about me": semantic search over every content item, on the visitor's
// device. Progressive enhancement: hidden until its script runs, so the page
// without JavaScript is unchanged.
import { buildDocs } from '../lib/search';
import { archive, projects, research, site, skillGroups } from '../lib/content';

// Only what the results list needs; the vectors arrive lazily from
// src/content/generated/embeddings.json when someone searches.
const docs = buildDocs({ research, projects, site, skillGroups, archive }).map(({ id, type, title, href, text }) => ({ id, type, title, href, text }));
---

<div class="ask" role="search" aria-label="Ask about me" data-ask hidden>
  <label class="ask-label mono" for="ask-q">Ask about me</label>
  <form class="ask-form" data-ask-form>
  <input
    id="ask-q"
    class="ask-input"
    type="search"
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="search"
    placeholder="e.g. object detection research"
    aria-describedby="ask-status"
  />
  <button type="submit" class="button button--primary ask-go" data-ask-go>Ask</button>
  </form>
  <p id="ask-status" class="ask-status muted" aria-live="polite">Searches everything on this page by meaning. Press Ask or Enter.</p>
  <ol class="ask-results" data-ask-results></ol>
  <script type="application/json" data-ask-docs set:html={JSON.stringify(docs)} />
</div>

<script>
  import { embed, onModelState } from '../lib/embed-client';
  import { api, hasApi, WAKING } from '../lib/api';
  import { topMatches, whyLine, type Doc } from '../lib/search';

  const root = document.querySelector<HTMLElement>('[data-ask]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('#ask-q')!;
    const status = root.querySelector<HTMLElement>('#ask-status')!;
    const list = root.querySelector<HTMLOListElement>('[data-ask-results]')!;
    const docs: Doc[] = JSON.parse(root.querySelector('[data-ask-docs]')!.textContent || '[]');
    const byId = new Map(docs.map((d) => [d.id, d]));
    const idle = status.textContent ?? '';
    root.hidden = false;

    let vectors: Promise<{ id: string; vector: number[] }[]> | null = null;
    const loadVectors = () =>
      (vectors ??= import('../content/generated/embeddings.json').then((m) => m.default.items));


    let busy = false;
    onModelState((s) => {
      if (s === 'loading' && busy) status.textContent = 'Loading the language model (first search only)…';
      if (s === 'error') status.textContent = 'The search model could not load. Everything below still works.';
    });

    const clearHits = () => document.querySelectorAll('.ask-hit').forEach((el) => el.classList.remove('ask-hit'));

    let seq = 0;
    const go = root.querySelector<HTMLButtonElement>('[data-ask-go]')!;
    const form = root.querySelector<HTMLFormElement>('[data-ask-form]')!;
    const setBusy = (on: boolean) => {
      go.disabled = on;
      go.textContent = on ? 'Searching…' : 'Ask';
      root.classList.toggle('ask-busy', on);
    };

    // The server runs the same MiniLM model over the same item vectors. If it
    // can't be reached, fall back to running the model in this browser.
    async function rank(query: string): Promise<{ ids: { id: string; score: number }[]; vector?: number[] }> {
      if (hasApi()) {
        try {
          const r = await api<{ results: { id: string; score: number }[] }>(
            '/search',
            { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ query }) },
            { onSlow: () => (status.textContent = WAKING) },
          );
          return { ids: r.results };
        } catch {
          status.textContent = 'Server unavailable, so searching on your device instead (downloads a 45 MB model once)…';
        }
      } else {
        status.textContent = 'Loading the search model on your device (45 MB, first search only)…';
      }
      const [items, [vector]] = await Promise.all([loadVectors(), embed([query])]);
      return { ids: topMatches(vector, items).map(({ item, score }) => ({ id: item.id, score })), vector: Array.from(vector) };
    }

    async function search(raw: string) {
      const query = raw.trim();
      const mine = ++seq;
      if (query.length < 3) {
        list.replaceChildren();
        clearHits();
        status.textContent = query ? 'Type a few more letters.' : idle;
        return;
      }
      busy = true;
      setBusy(true);
      status.textContent = 'Searching…';
      try {
        const { ids, vector } = await rank(query);
        if (mine !== seq) return;
        const results = ids
          .filter((r) => byId.has(r.id))
          .map(({ id, score }) => {
            const d = byId.get(id)!;
            return { id: d.id, type: d.type, title: d.title, href: d.href, score: Number(score.toFixed(4)), why: whyLine(query, d.text) };
          });
        clearHits();
        list.replaceChildren(
          ...results.map((r) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = r.href;
            a.textContent = r.title;
            const why = document.createElement('span');
            why.className = 'ask-why muted';
            why.textContent = `${r.type} · ${r.why}`;
            li.append(a, why);
            document.getElementById(r.id)?.classList.add('ask-hit');
            return li;
          }),
        );
        status.textContent = results.length
          ? `Closest matches for "${query}". Tap one to jump there.`
          : 'Nothing close enough. Try other words.';
        window.dispatchEvent(new CustomEvent('ask', { detail: { query, vector, results } }));
      } catch {
        if (mine === seq) status.textContent = 'Search is unavailable right now. Everything below still works.';
      } finally {
        busy = false;
        if (mine === seq) setBusy(false);
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void search(input.value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) {
        input.value = '';
        void search('');
      }
    });
  }
</script>

<style is:global>
  .ask { padding-top: 2.5rem; max-width: var(--measure); }
  .ask-label { display: block; font-size: 0.75rem; color: var(--muted); margin-bottom: 0.4rem; }
  .ask-input {
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    font: inherit;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ask-input::placeholder { color: var(--muted); opacity: 0.8; }
  .ask-form { display: flex; gap: 0.5rem; }
  .ask-form .ask-input { flex: 1; min-width: 0; }
  .ask-go { flex: none; }
  .ask-go:disabled { opacity: 0.7; cursor: progress; }
  .ask-status { font-size: 0.85rem; margin: 0.4rem 0 0; }
  .ask-results { margin: 0.6rem 0 0; padding-left: 1.4rem; }
  .ask-results:empty { display: none; }
  .ask-results li { margin-bottom: 0.45rem; line-height: 1.4; }
  .ask-why { display: block; font-size: 0.82rem; }
</style>
