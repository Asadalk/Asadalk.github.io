---
// Fonts are self-hosted and subset (Latin, plus Devanagari for the signboards).
import '@fontsource/young-serif/latin-400.css';
import '@fontsource/tiro-devanagari-hindi/devanagari-400.css';
import '@fontsource/tiro-devanagari-hindi/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-400.css';
import '@fontsource/atkinson-hyperlegible/latin-700.css';
import '@fontsource/atkinson-hyperlegible/latin-400-italic.css';
import '@fontsource/martian-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/glass.css';
import MiniBar from '../components/MiniBar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** The plain résumé view has no mini-bar and no motion. */
  plain?: boolean;
}

const {
  title = `${site.name}: AI & Data Science, IIT Jodhpur`,
  description = site.bio,
  plain = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Person data for search engines: name, school and profiles only. Never a phone.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: Astro.site?.toString(),
  email: `mailto:${site.contact.email}`,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Jodhpur' },
  sameAs: [site.contact.github, site.contact.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ece6d8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1a21" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/media/portrait/asad-640.jpg', Astro.site)} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Asadullah Faisal in front of the Taj Mahal" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <script is:inline>
      // Apply a saved manual theme before first paint. Storage can throw; ignore it.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class={plain ? 'plain' : undefined}>
    {!plain && (
      <>
        <div class="backdrop" aria-hidden="true"></div>
        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
          <filter id="lg-refract" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.006 0.009" numOctaves="2" seed="11" result="noise" />
            <feGaussianBlur in="noise" stdDeviation="3" result="liquid" />
            <feDisplacementMap in="SourceGraphic" in2="liquid" scale="46" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </svg>
        <script is:inline>
          // Lens refraction through an SVG filter in backdrop-filter only renders
          // in Chromium; everyone else keeps the clean frosted glass.
          try {
            if (navigator.userAgentData && navigator.userAgentData.brands.some((b) => /Chromium/.test(b.brand))) {
              document.documentElement.classList.add('lg-refract');
            }
          } catch {}
        </script>
      </>
    )}
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <Footer plain={plain} />
    {!plain && <MiniBar />}
    <script is:inline>
      // Cache model files after first use (see public/sw.js). Harmless if unsupported.
      if ('serviceWorker' in navigator) addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
    </script>
  </body>
</html>
