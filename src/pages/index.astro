---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skills from '../components/Skills.astro';
import Street from '../components/Street.astro';
import AskAboutMe from '../components/AskAboutMe.astro';
import { site, projects } from '../lib/content';

// Owner's curated cold-start order. The brain (Phase 5) may reorder cards
// below the fold; it never hides any.
const projectOrder = ['opspilot', 'semantic-hire', 'cellular', 'smoketrail'];
const ordered = projectOrder.map((id) => projects.find((p) => p.id === id)!);
const primaryEdu = site.education.find((e) => e.primary)!;
---

<Base>
  <header class="hero" slot="header">
    <div class="wrap intro">
      <p class="eyebrow mono">{site.name} · {site.tagline}</p>
      <h1 data-headline>{site.headlines.default}</h1>
      <div class="actions">
        <a class="button button--primary" href="#scan">Scan a photo with my model</a>
        <a class="button button--ghost" href="/resume/">Plain résumé view</a>
      </div>
    </div>
    <Street />
  </header>

  <div class="wrap feed">
    <section id="about" aria-labelledby="about-h">
      <h2 id="about-h">About</h2>
      <p class="lede">{site.bio}</p>
      {site.about.map((p) => <p>{p}</p>)}
    </section>

    <AskAboutMe />

    <section id="research" aria-labelledby="research-h">
      <h2 id="research-h">Research</h2>
      <ResearchCard />
    </section>

    <section id="projects" aria-labelledby="projects-h">
      <h2 id="projects-h">Projects</h2>
      {ordered.map((p) => <ProjectCard project={p} />)}
      <p><a href="/archive/">Smaller projects and coursework →</a></p>
    </section>

    <section id="experience" aria-labelledby="experience-h">
      <h2 id="experience-h">Experience</h2>
      <ul class="plain-list">
        {site.experience.map((x) => (
          <li id={x.id}>
            <strong>{x.role}</strong>, {x.org}
            <span class="mono muted dates">{x.dates}</span>
            {x.refersTo && <a href={`#${x.refersTo}`}>details above</a>}
          </li>
        ))}
      </ul>
    </section>

    <section id="education" aria-labelledby="education-h">
      <h2 id="education-h">Education</h2>
      <p id={primaryEdu.id}>
        <strong>{primaryEdu.degree}</strong><br />
        {primaryEdu.institution} <span class="mono muted dates">{primaryEdu.years}</span>
      </p>
      <p class="muted coursework">Coursework: {primaryEdu.coursework?.join(', ')}</p>
      <ul class="plain-list">
        {site.education.filter((e) => !e.primary).map((e) => (
          <li id={e.id}>{e.degree}, {e.institution} <span class="mono muted dates">{e.years}</span></li>
        ))}
      </ul>
      <h3>Achievements</h3>
      <ul class="plain-list">
        {site.achievements.map((a) => <li id={a.id}>{a.text}</li>)}
      </ul>
    </section>

    <section id="skills" aria-labelledby="skills-h">
      <h2 id="skills-h">Skills</h2>
      <p class="muted">Each skill links to the work that uses it.</p>
      <Skills />
    </section>

    <section id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Contact</h2>
      <p>The fastest way to reach me is email.</p>
      <ul class="contact">
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href={site.contact.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={site.contact.github} rel="me">GitHub</a></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero { padding: 2rem 0 0; }
  @media (min-width: 48rem) { .hero { padding-top: 4.5rem; } }
  .intro h1 { max-width: 20ch; }
  .eyebrow { font-size: 0.75rem; color: var(--muted); margin-bottom: 1rem; }
  .lede { font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0 1.5rem; }
  .feed section { padding-top: 2.5rem; }
  .plain-list { padding-left: 1.1rem; }
  .plain-list li { margin-bottom: 0.5rem; }
  .dates { font-size: 0.75rem; margin: 0 0.5rem; white-space: nowrap; }
  .coursework { font-size: 0.95rem; }
  .contact { list-style: none; padding: 0; font-size: 1.1rem; }
  .contact li { margin-bottom: 0.4rem; }
</style>
